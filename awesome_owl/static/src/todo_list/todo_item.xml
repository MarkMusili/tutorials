<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoItem">
        <div t-att-class="props.todo.isCompleted ? 'text-decoration-line-through text-muted' : ''">
            <input type="checkbox" t-on-change="change"/> <t t-esc="props.todo.id"/> - <t t-esc="props.todo.description"/> <span t-on-click="del" class="fa fa-remove"/>
        </div>
    </t>

</templates>
